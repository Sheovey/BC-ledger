# ---- 依赖 ----
node_modules/

# ---- 构建产物 ----
# 每次 build 都原地覆盖，入库只会让 diff 全是噪音。
# 回退代码后重新 npm run build:weapp 即可，所以不入库。
dist/
.swc/
build.log

# ---- 验收产物 ----
# preview/ 下全是 verify-*.cjs 与 shot-*.cjs 跑出来的截图和 xlsx，可随时重新生成。
preview/

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db

# ---- 微信开发者工具的本机私有配置 ----
# 记录本机的库版本与编译开关，官方约定不进版本库；每次在 IDE 里改设置都会变，
# 入库只会产生噪音，且会覆盖协作者自己的偏好。project.config.json 才入库。
project.private.config.json
