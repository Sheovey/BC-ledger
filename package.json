{
  "name": "ledger-taro",
  "version": "1.0.0",
  "private": true,
  "description": "小账本 · 微信小程序端（Taro 4 + React 18）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "save": "node scripts/save.cjs",
    "log": "git log --oneline --max-count=15"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.1",
    "@tarojs/helper": "4.3.1",
    "@tarojs/plugin-framework-react": "4.3.1",
    "@tarojs/plugin-platform-weapp": "4.3.1",
    "@tarojs/react": "4.3.1",
    "@tarojs/runtime": "4.3.1",
    "@tarojs/shared": "4.3.1",
    "@tarojs/taro": "4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tarojs/cli": "4.3.1",
    "@tarojs/webpack5-runner": "4.3.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.3.1",
    "miniprogram-automator": "^0.13.0",
    "sass": "^1.77.8",
    "typescript": "^5.6.3",
    "webpack": "^5.91.0"
  }
}
